/**
 * 問4 模範解答: ロードバランサからVMへの通信を許可する
 *
 * 出題範囲: 第3回(S32)
 *
 * ★ この問題で問うていること ★
 *
 * 問3まで正しく作っても、ブラウザで開くと **503** が返る。
 * ロードバランサは VPC の外にいるので、
 * VMに届く前に Firewall Rules で止められているから。
 *
 * バックエンドサービスが「健全なバックエンドが無い」と判断して
 * 503 Service Unavailable を返す。
 *
 * ★ 採点のポイント ★
 *   1. source_ranges に **2つとも** 入っているか
 *        130.211.0.0/22  ヘルスチェック
 *        35.191.0.0/16   ヘルスチェック + LBからの転送
 *      → 片方だけだと通らない
 *   2. ポート80が開いているか
 *   3. target_tags が問2のVMのタグと一致しているか
 *      → タグ名がずれていると、ルールはできるのに通らない
 *
 * ★ よくある誤答 ★
 *   source_ranges = ["0.0.0.0/0"]
 *     → 通ることは通るが、**インターネット全体から直接VMに入れる**。
 *       LB経由という前提が崩れるので減点。
 *       今回はVMに外部IPが無いので実害は小さいが、
 *       考え方として正しくない
 */
resource "google_compute_firewall" "allow_lb_to_web" {
  name    = "${var.user_name}-allow-lb-to-web"
  network = google_compute_network.vpc.name

  allow {
    protocol = "tcp"
    ports    = ["80"]
  }

  /**
   * ★ Google のロードバランサとヘルスチェックの固定レンジ ★
   *
   * この2つは覚えるものではなく、
   * 「調べれば公式ドキュメントに書いてある」と知っていればよい。
   * ただし **2つある** ことは覚えておくこと。
   */
  source_ranges = [
    "130.211.0.0/22",
    "35.191.0.0/16",
  ]

  // 問2のVMに付けたタグ
  target_tags = ["${var.user_name}-web"]
}
